{
  "extraKnownMarketplaces": {
    "fde-sdlc": {
      "source": {
        "source": "directory",
        "path": "../sf-sdlc-plugins"
      }
    }
  },
  "enabledPlugins": {
    "sf-sdlc@fde-sdlc": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.sf/**)",
      "Read(./.sfdx/**)",
      "Read(~/.sf/**)",
      "Read(~/.sfdx/**)",
      "Read(./**/*.key)",
      "Bash(sf org login jwt *)",
      "Bash(sf org logout *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(sf org create scratch *)"
    ]
  }
}
